# =====================================================================
# HolonMed — plantilla de configuración
# Copia este archivo a .env y rellena los valores. .env está en
# .gitignore y NUNCA debe subirse al repositorio.
# =====================================================================

# --- LLM (Ollama local — privacidad total, sin salida a internet) ----
HOLONMED_OLLAMA_HOST=http://127.0.0.1:11434
# Modelo principal de razonamiento clínico
HOLONMED_MODEL_CLINICAL=gemma2:9b
# Modelo rápido para triaje y clasificación de intención
HOLONMED_MODEL_ROUTER=llama3
# Temperatura global. 0 = determinista. En clínica NO la subas.
HOLONMED_TEMPERATURE=0.0

# --- BASE DE DATOS (ArangoDB) ----------------------------------------
HOLONMED_ARANGO_URL=http://localhost:8529
HOLONMED_ARANGO_DB=holonmed
HOLONMED_ARANGO_USER=root
# Cámbiala. Nunca dejes 'root' en algo que escuche fuera de localhost.
HOLONMED_ARANGO_PASSWORD=changeme

# --- MOTOR SNOMED ----------------------------------------------------
# 'local'  = índice en memoria (pandas + rapidfuzz + cache pickle)
# 'arango' = búsqueda BM25 sobre ArangoDB ArangoSearch
# 'auto'   = usa local si el Snapshot existe, si no arango
HOLONMED_SNOMED_BACKEND=auto
HOLONMED_SNOMED_DIR=./data/snomed
HOLONMED_SNOMED_DESCRIPTIONS=sct2_Description_SpanishExtensionSnapshot-es_INT_20251110.txt
HOLONMED_SNOMED_MAP=der2_iisssccRefset_ExtendedMapSpanishExtensionSnapshot_INT_20251110.txt
HOLONMED_SNOMED_RELATIONSHIPS=sct2_Relationship_SpanishExtensionSnapshot_INT_20251110.txt

# --- UMBRALES DEL VALIDADOR (ajustar con cuidado, son de seguridad) --
# Score SNOMED mínimo para que un hallazgo se considere VALIDADO
HOLONMED_THRESHOLD_VALIDATED=85
# Score SNOMED mínimo para marcar ALERTA en vez de descartar como RUIDO
HOLONMED_THRESHOLD_ALERT=75
# Score mínimo para molestarse en correr la auditoría lógica (coste LLM)
HOLONMED_THRESHOLD_AUDIT=60

# --- API -------------------------------------------------------------
HOLONMED_API_HOST=127.0.0.1
HOLONMED_API_PORT=8000
# Orígenes permitidos por CORS, separados por coma. NO uses '*' en producción.
HOLONMED_CORS_ORIGINS=http://localhost:5173

# --- ALMACENAMIENTO DE DOCUMENTOS ------------------------------------
HOLONMED_DOCS_DIR=./generated_docs

# --- INTEGRACIONES OPCIONALES ----------------------------------------
# Deja vacío para desactivar. Si lo activas, la ruta apunta a un archivo
# de credenciales FUERA del repositorio.
HOLONMED_GDRIVE_ENABLED=false
HOLONMED_GDRIVE_CREDENTIALS_PATH=
HOLONMED_GDRIVE_FOLDER_ID=
