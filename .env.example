# =====================================================================
# HolonMed — plantilla de configuración
# Copia este archivo a .env y ajusta lo que necesites. Todos los valores
# tienen un valor por defecto razonable: el sistema arranca sin .env.
# .env está en .gitignore y NUNCA debe subirse al repositorio.
# =====================================================================

# --- LLM (Ollama local — privacidad total, sin salida a internet) ----
# Protocolo del servidor local: "ollama" (por defecto) u "openai", la API
# compatible que sirven llama.cpp (`llama-server`) y LM Studio. Con "openai"
# el contexto lo fija el servidor al arrancar y el nombre de modelo de abajo
# debe coincidir con el id que el servidor lista en /v1/models.
HOLONMED_LLM_BACKEND=ollama
HOLONMED_OLLAMA_HOST=http://127.0.0.1:11434
HOLONMED_OPENAI_HOST=http://127.0.0.1:8080
# Modelo principal de razonamiento clínico
HOLONMED_MODEL_CLINICAL=gemma2:9b
# Modelo rápido para triaje, clasificación de intención y re-ranking
HOLONMED_MODEL_ROUTER=llama3
# Temperatura global. 0 = determinista. En clínica NO la subas.
HOLONMED_TEMPERATURE=0.0

# --- Almacenamiento --------------------------------------------------
# SQLite embebido: un único archivo, sin servidor que instalar. Contiene
# datos de paciente, así que cifra el disco donde viva.
HOLONMED_DB_PATH=./data/holonmed.db

# --- Vocabulario clínico ---------------------------------------------
# El vocabulario semilla es contenido propio del proyecto y se carga solo
# la primera vez. Para importar SNOMED CT u otra terminología:
#   python scripts/importar_terminologia.py --help
HOLONMED_AUTOCARGAR_SEMILLA=true
HOLONMED_VOCABULARIO_SEMILLA=./data/vocabulario_semilla.json

# --- Umbrales del validador (ajustar con cuidado, son de seguridad) --
# Score mínimo para que un hallazgo se considere VALIDADO
HOLONMED_THRESHOLD_VALIDATED=85
# Score mínimo para marcar ALERTA en vez de descartar como RUIDO
HOLONMED_THRESHOLD_ALERT=75
# Score mínimo para molestarse en correr la auditoría lógica (coste LLM)
HOLONMED_THRESHOLD_AUDIT=60
# Similitud mínima para aceptar un skill-hint difuso sin pasar por el LLM
HOLONMED_THRESHOLD_HINT_FUZZY=92
# Similitud mínima del fallback difuso cuando el LLM no está disponible
HOLONMED_THRESHOLD_FUZZY_FALLBACK=92

# --- API -------------------------------------------------------------
HOLONMED_API_HOST=127.0.0.1
HOLONMED_API_PORT=8000
# Orígenes permitidos por CORS, separados por coma. NO uses '*'.
HOLONMED_CORS_ORIGINS=http://localhost:5173

# --- Rutas -----------------------------------------------------------
HOLONMED_SKILLS_DIR=./skills
# Los PDF generados contienen datos identificables del paciente.
HOLONMED_DOCS_DIR=./generated_docs
